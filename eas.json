{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mespochesbackend-production-9835.up.railway.app/api",
        "EXPO_PUBLIC_WEB_URL": "https://www.mespoches.store",
        "EXPO_PUBLIC_PRIVACY_URL": "https://www.mespoches.store/legal/privacy",
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MONEY_CAPTURE": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
